AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# This recipe is BYO-only: EVERY realtime MLLM vendor requires its own key.
# Pick one with REALTIME_VENDOR (default: openai) and set that vendor's creds below.
# Optionally override the model with REALTIME_MODEL (per-vendor default applies otherwise).
REALTIME_VENDOR=openai
# REALTIME_MODEL=gpt-4o-realtime-preview
# AGENT_GREETING=Hi! I'm a realtime voice assistant — let's just talk.

# --- Vendor credentials (set the block for the REALTIME_VENDOR you selected) ---

# openai  (default; model gpt-4o-realtime-preview)
OPENAI_API_KEY=your-openai-realtime-key

# gemini  (model gemini-2.0-flash-live-001)
# GEMINI_API_KEY=your-gemini-api-key

# xai  (Grok realtime)
# XAI_API_KEY=your-xai-api-key

# vertexai  (model gemini-2.0-flash-live-001)
# GOOGLE_APPLICATION_CREDENTIALS_JSON=your-adc-credentials-json
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GOOGLE_LOCATION=us-central1
